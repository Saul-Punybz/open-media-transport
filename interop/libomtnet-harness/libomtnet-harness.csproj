<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drives the real upstream libomtnet (built from reference/libomtnet, gitignored)
    so its behaviour on the wire can be captured and compared with ours.
    libvmx.dylib is needed only to encode or decode video; pass its path with
    -p:LibVmx=/path/to/libvmx.dylib.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LibomtnetHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../reference/libomtnet/libomtnet.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(LibVmx)' != ''">
    <None Include="$(LibVmx)" Link="libvmx.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
